# ---- Estúdio Megadino ----
# Porta interna do app (o Caddy recebe o HTTPS e repassa para cá)
PORT=3000

# Domínio público (usado pelo Caddy para emitir o certificado HTTPS automático)
DOMAIN=estudio.suaempresa.com.br

# Chave da API da Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Modelo usado para escrever os textos
ANTHROPIC_MODEL=claude-sonnet-5-5

# Primeiro administrador (criado só quando o banco está vazio; ele troca a senha no 1º acesso)
ADMIN_NAME=Nathan
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Deixe true em produção (site com HTTPS). Use false só para testar em http://localhost
COOKIE_SECURE=true
# Duração do login, em dias
SESSION_DAYS=7
# Limite de gerações com IA por usuário por dia (0 = sem limite)
DAILY_AI_LIMIT=0

# ---- Instagram (opcional): publicar direto pelo Estúdio ----
# Endereço público do site. Se ficar vazio, usa https://DOMAIN
PUBLIC_URL=
# App da Meta com o produto "Instagram API com login do Instagram" (ID e chave secreta do app do Instagram)
IG_APP_ID=
IG_APP_SECRET=

# ---- Studio ML (opcional): buscar produtos no Mercado Livre ----
# App em developers.mercadolivre.com.br (URI de redirect: https://SEU_DOMINIO/ml/retorno)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Scraping próprio de reserva (opcional): endpoint que recebe POST {"acao":"buscar","q":...} e {"acao":"detalhe","url":...}
SCRAPER_URL=
SCRAPER_TOKEN=
